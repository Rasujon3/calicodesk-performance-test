# Copy this file to .env and replace the placeholders.
# Never commit .env. It is gitignored.

# Used by Playwright (npm run test:runner).
# The k6 runner does not use TEST_ENV; it requires an explicit --env.
# There is no automatic fallback to live.
TEST_ENV=local

# Application URLs (no trailing slash).
# These are placeholders only. Replace them in your local .env.
LOCAL_BASE_URL=http://localhost:8000
DEV_BASE_URL=https://dev.example.com
LIVE_BASE_URL=https://www.example.com

# Authentication credentials (Playwright browser + k6 HTTP lifecycle).
# k6: find-workspaces → POST /auth/login → bootstrap-data → logout → 401 probe.
# On non-local envs, login captcha may block the k6 login POST unless disabled
# or test keys are configured on the application.
# Use a dedicated non-production test account. Do not commit real credentials.
TEST_USER_EMAIL=test-user@example.com
TEST_USER_PASSWORD=replace-with-local-test-password
