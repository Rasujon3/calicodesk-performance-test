{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "config/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.ts",
    "scenarios/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "results",
    "reports"
  ]
}